// Menu bar component for Shinku Editor

export component MenuBar {
    width: 100%;
    height: 40px;
    
    callback new-file();
    callback open-file();
    callback save-file();
    callback save-file-as();
    callback new-folder();
    callback show-about();
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: #2d2d2d;
        padding: 8px;
        spacing: 16px;

        // New button
        menu-button-new := Rectangle {
            width: 60px;
            height: 24px;
            background: menu-touch-new.has-hover ? #3e3e3e : transparent;
            border-radius: 4px;
            
            Text {
                text: "New";
                color: #cccccc;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            
            menu-touch-new := TouchArea {
                clicked => { root.new-file(); }
            }
        }

        // Open button
        menu-button-open := Rectangle {
            width: 60px;
            height: 24px;
            background: menu-touch-open.has-hover ? #3e3e3e : transparent;
            border-radius: 4px;
            
            Text {
                text: "Open";
                color: #cccccc;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            
            menu-touch-open := TouchArea {
                clicked => { root.open-file(); }
            }
        }

        // Save button
        menu-button-save := Rectangle {
            width: 60px;
            height: 24px;
            background: menu-touch-save.has-hover ? #3e3e3e : transparent;
            border-radius: 4px;
            
            Text {
                text: "Save";
                color: #cccccc;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            
            menu-touch-save := TouchArea {
                clicked => { root.save-file(); }
            }
        }

        // Save As button
        menu-button-save-as := Rectangle {
            width: 80px;
            height: 24px;
            background: menu-touch-save-as.has-hover ? #3e3e3e : transparent;
            border-radius: 4px;
            
            Text {
                text: "Save As";
                color: #cccccc;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: 12px;
            }
            
            menu-touch-save-as := TouchArea {
                clicked => { root.save-file-as(); }
            }
        }

        // About button
        menu-button-about := Rectangle {
            width: 60px;
            height: 24px;
            background: menu-touch-about.has-hover ? #3e3e3e : transparent;
            border-radius: 4px;
            
            Text {
                text: "About";
                color: #cccccc;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            
            menu-touch-about := TouchArea {
                clicked => { root.show-about(); }
            }
        }

        // Spacer
        Rectangle { horizontal-stretch: 1; }
    }
    }
}
