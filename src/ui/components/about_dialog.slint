// About dialog component

export component AboutDialog {
    in-out property <bool> show-about: false;
    
    callback close();
    
    if root.show-about: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        TouchArea {
            clicked => {
                root.show-about = false;
                root.close();
            }
        }
        
        Rectangle {
            width: 500px;
            height: 400px;
            background: #2d2d2d;
            border-radius: 8px;
            
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                
                Text {
                    text: "Shinku Editor";
                    font-size: 24px;
                    font-weight: 800;
                    color: #d4d4d4;
                }
                
                Text {
                    text: "Version 0.1.0";
                    font-size: 14px;
                    color: #999999;
                }
                
                Rectangle {
                    height: 1px;
                    background: #444444;
                }
                
                Text {
                    text: "A modern, lightweight text editor written in 100% Rust";
                    font-size: 12px;
                    color: #d4d4d4;
                    wrap: word-wrap;
                }
                
                Text {
                    text: "Author: Alaa\nLicense: MIT\nBuilt with Rust & Slint";
                    font-size: 11px;
                    color: #999999;
                }
                
                Rectangle {
                    horizontal-stretch: 1;
                }
                
                HorizontalLayout {
                    spacing: 12px;
                    
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    
                    close-button := Rectangle {
                        width: 100px;
                        height: 32px;
                        background: #007acc;
                        border-radius: 4px;
                        
                        Text {
                            text: "Close";
                            color: #ffffff;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        
                        TouchArea {
                            clicked => {
                                root.show-about = false;
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
