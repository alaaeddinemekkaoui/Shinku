// Find and Replace bar component

export component FindBar {
    in-out property <string> find-text: "";
    in-out property <string> replace-text: "";
    in-out property <bool> is-visible: false;
    
    callback find-text-changed(string);
    callback replace-all(string, string);
    callback close-find();
    
    if root.is-visible: Rectangle {
        height: 40px;
        background: #2d2d2d;
        
        HorizontalLayout {
            padding: 8px;
            spacing: 12px;
            
            Text {
                text: "Find:";
                color: #d4d4d4;
                vertical-alignment: center;
            }
            
            TextInput {
                width: 200px;
                text: root.find-text;
                input-type: text;
                edited => {
                    root.find-text = self.text;
                    root.find-text-changed(self.text);
                }
            }
            
            Text {
                text: "Replace:";
                color: #d4d4d4;
                vertical-alignment: center;
            }
            
            TextInput {
                width: 200px;
                text: root.replace-text;
                input-type: text;
                edited => {
                    root.replace-text = self.text;
                }
            }
            
            replace-all-btn := Rectangle {
                width: 100px;
                height: 30px;
                background: #007acc;
                border-radius: 4px;
                
                Text {
                    text: "Replace All";
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 12px;
                }
                
                TouchArea {
                    clicked => {
                        root.replace-all(root.find-text, root.replace-text);
                    }
                }
            }
            
            Rectangle { horizontal-stretch: 1; }
            
            close-btn := Rectangle {
                width: 30px;
                height: 30px;
                background: #555555;
                border-radius: 4px;
                
                Text {
                    text: "✕";
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                }
                
                TouchArea {
                    clicked => {
                        root.is-visible = false;
                        root.close-find();
                    }
                }
            }
        }
    }
}
