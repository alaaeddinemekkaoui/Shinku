// Shinku Text Editor - Main Window
// A modern, lightweight text editor written in Rust

import { VerticalBox } from "std-widgets.slint";
import { MenuBar } from "components/menu.slint";
import { FindBar } from "components/find_bar.slint";
import { EditorArea } from "components/editor.slint";
import { StatusBar } from "components/status_bar.slint";
import { AboutDialog } from "components/about_dialog.slint";

export component AppWindow inherits Window {
    title: "Shinku Editor";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: #1e1e1e;

    // Properties
    in-out property <string> text-content: "";
    in-out property <string> line-numbers: "1";
    in-out property <string> document-title: "Untitled";
    in-out property <int> cursor-line: 1;
    in-out property <int> cursor-column: 1;
    in-out property <bool> is-modified: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> show-find-bar: false;
    in-out property <bool> show-about-dialog: false;
    in-out property <string> find-text: "";
    in-out property <string> replace-text: "";

    // Callbacks
    callback text-input(string);
    callback backspace();
    callback delete();
    callback enter();
    callback move-cursor(string);
    callback undo();
    callback redo();
    callback new-file();
    callback open-file();
    callback new-folder();
    callback save-file();
    callback save-file-as();
    callback show-about();
    callback find-text-changed(string);
    callback replace-all(string, string);
    callback close-find();

    VerticalBox {
        // Menu bar
        menu-bar := MenuBar {
            new-file => { root.new-file(); }
            open-file => { root.open-file(); }
            save-file => { root.save-file(); }
            save-file-as => { root.save-file-as(); }
            show-about => {
                root.show-about-dialog = true;
                root.show-about();
            }
        }

        // Editor area
        editor-area := EditorArea {
            text-content: root.text-content;
            line-numbers: root.line-numbers;
            
            text-input(text) => { root.text-input(text); }
            backspace() => { root.backspace(); }
            delete() => { root.delete(); }
            enter() => { root.enter(); }
            move-cursor(dir) => { root.move-cursor(dir); }
            undo() => { root.undo(); }
            redo() => { root.redo(); }
        }

        // Find bar
        find-bar := FindBar {
            is-visible: root.show-find-bar;
            find-text: root.find-text;
            replace-text: root.replace-text;
            
            find-text-changed(text) => { root.find-text-changed(text); }
            replace-all(find, replace) => { root.replace-all(find, replace); }
            close-find() => { 
                root.show-find-bar = false;
                root.close-find(); 
            }
        }

        // Status bar
        status-bar := StatusBar {
            cursor-line: root.cursor-line;
            cursor-column: root.cursor-column;
            is-modified: root.is-modified;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
        }
    }

    // About dialog (popup overlay)
    about-dialog := AboutDialog {
        show-about: root.show-about-dialog;
        close => {
            root.show-about-dialog = false;
        }
    }
}
