{
  "app": {
    "name": "Shinku Editor",
    "version": "0.1.0",
    "author": "Alaa",
    "description": "A modern, lightweight text editor written in Rust",
    "license": "MIT",
    "website": "https://github.com/alaaeddinemekkaoui/shinku",
    "repository": "https://github.com/alaaeddinemekkaoui/shinku"
  },
  "editor": {
    "font_name": "Consolas",
    "font_size": 16,
    "theme": "dark",
    "line_numbers": true,
    "word_wrap": true
  },
  "ui": {
    "background_color": "#1e1e1e",
    "text_color": "#d4d4d4",
    "menu_bar_color": "#2d2d2d",
    "status_bar_color": "#007acc",
    "gutter_color": "#252525"
  }
}
