{
  "shortcuts": [
    {
      "action": "New File",
      "keys": "Ctrl+N",
      "description": "Create a new blank document"
    },
    {
      "action": "Open File",
      "keys": "Ctrl+O",
      "description": "Open an existing file"
    },
    {
      "action": "Save File",
      "keys": "Ctrl+S",
      "description": "Save the current document"
    },
    {
      "action": "Save As",
      "keys": "Ctrl+Shift+S",
      "description": "Save the document with a new name"
    },
    {
      "action": "Undo",
      "keys": "Ctrl+Z",
      "description": "Undo the last action"
    },
    {
      "action": "Redo",
      "keys": "Ctrl+Y",
      "description": "Redo the last undone action"
    },
    {
      "action": "Find & Replace",
      "keys": "Ctrl+F",
      "description": "Open find and replace dialog"
    },
    {
      "action": "Go to Line Start",
      "keys": "Home",
      "description": "Move cursor to start of line"
    },
    {
      "action": "Go to Line End",
      "keys": "End",
      "description": "Move cursor to end of line"
    },
    {
      "action": "Navigate Up",
      "keys": "Up Arrow",
      "description": "Move cursor up one line"
    },
    {
      "action": "Navigate Down",
      "keys": "Down Arrow",
      "description": "Move cursor down one line"
    },
    {
      "action": "Navigate Left",
      "keys": "Left Arrow",
      "description": "Move cursor left one character"
    },
    {
      "action": "Navigate Right",
      "keys": "Right Arrow",
      "description": "Move cursor right one character"
    },
    {
      "action": "Delete Character",
      "keys": "Backspace",
      "description": "Delete character before cursor"
    },
    {
      "action": "Delete Next",
      "keys": "Delete",
      "description": "Delete character after cursor"
    },
    {
      "action": "New Line",
      "keys": "Return/Enter",
      "description": "Insert a new line"
    }
  ]
}
